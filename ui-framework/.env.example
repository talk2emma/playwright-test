# Copy this file to `.env` and adjust values for your environment.
# `.env` is git-ignored, so secrets never get committed.
# Every value here is optional — sensible defaults live in src/config/env.ts.

# Front-end URL of the application under test (no trailing slash).
BASE_URL=https://eventhub.rahulshettyacademy.com

# Back-end API URL — used to create test users quickly before UI tests run.
API_URL=https://api.eventhub.rahulshettyacademy.com/api

# Password used for every generated test user (emails are random per test).
TEST_PASSWORD=#Test1234
